<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.peachsoft.otryx</groupId>
        <artifactId>otryx-rpc</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>otryx-benchmarks</artifactId>
    <name>otryx-benchmarks</name>
    <description>JMH benchmarks for OTRYX RPC hot paths.</description>

    <properties>
        <maven.javadoc.skip>true</maven.javadoc.skip>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.peachsoft.otryx</groupId>
            <artifactId>otryx-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.peachsoft.otryx</groupId>
            <artifactId>otryx-serialization-fory</artifactId>
        </dependency>
        <dependency>
            <groupId>com.peachsoft.otryx</groupId>
            <artifactId>otryx-transport-vertx</artifactId>
        </dependency>
        <dependency>
            <groupId>com.peachsoft.otryx</groupId>
            <artifactId>otryx-proxy-bytebuddy</artifactId>
        </dependency>
        <dependency>
            <groupId>com.peachsoft.otryx</groupId>
            <artifactId>otryx-observability-micrometer</artifactId>
        </dependency>
        <dependency>
            <groupId>com.peachsoft.otryx</groupId>
            <artifactId>otryx-observability-jfr</artifactId>
        </dependency>
        <dependency>
            <groupId>com.peachsoft.otryx</groupId>
            <artifactId>otryx-observability-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.peachsoft.otryx</groupId>
                            <artifactId>otryx-codegen</artifactId>
                            <version>${revision}</version>
                        </path>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>${jmh.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven-shade-plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>benchmarks</finalName>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.openjdk.jmh.Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
