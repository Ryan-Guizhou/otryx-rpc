<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.peachsoft.otryx</groupId>
        <artifactId>otryx-rpc</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>otryx-quickstart-consumer</artifactId>
    <name>otryx-quickstart-consumer</name>
    <description>Standalone OTRYX RPC consumer example.</description>
    <dependencies>
        <dependency>
            <groupId>com.peachsoft.otryx</groupId>
            <artifactId>otryx-quickstart-api</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.peachsoft.otryx</groupId>
            <artifactId>otryx-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.peachsoft.otryx</groupId>
            <artifactId>otryx-registry-nacos</artifactId>
        </dependency>
        <dependency>
            <groupId>com.peachsoft.otryx</groupId>
            <artifactId>otryx-registry-consul</artifactId>
        </dependency>
        <dependency>
            <groupId>com.peachsoft.otryx</groupId>
            <artifactId>otryx-registry-eureka</artifactId>
        </dependency>
        <dependency>
            <groupId>com.peachsoft.otryx</groupId>
            <artifactId>otryx-quickstart-provider</artifactId>
            <version>${revision}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <classifier>exec</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
